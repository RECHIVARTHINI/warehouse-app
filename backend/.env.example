# Local example only. Never commit real secrets.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/inventory
CORS_ORIGINS=http://localhost:5173
# Leave KEY_VAULT_URL empty for local development. In Azure, set it to
# https://YOUR-VAULT-NAME.vault.azure.net and store DATABASE_URL in that vault.
KEY_VAULT_URL=
KEY_VAULT_SECRET_NAME=DATABASE-URL
